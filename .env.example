# 本地开发环境变量示例
# 复制为 .env.local（开发用，不进 git）

# ---- 必需 ----
# 平台地址（默认 http://49.233.169.16）
NSEAP_SERVER_URL=http://49.233.169.16
# 学生/教师 api_key（从平台登录后下载 NSEAP-config-{学号}.json 获取）
NSEAP_API_KEY=
# 当前学生学号（from_agent 固定身份，防代交）
NSEAP_STUDENT_ID=

# ---- 可选 ----
# 班级/队列（同伴评审分配用）
NSEAP_COHORT=
# 角色：student（默认）| teacher
NSEAP_ROLE=student
# mock 模式：1=启用（本地开发无凭证时，返回假数据）
NSEAP_MOCK=1
